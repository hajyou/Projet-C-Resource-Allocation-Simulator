#include <stdio.h>
#include <stdlib.h>

void affiche(int nbLignes, int nbColonnes, int  tab[nbLignes][nbColonnes])
{
    for (int l = 0; l < nbLignes; l ++)
    {
        for (int c = 0; c < nbColonnes; c ++)
            printf(" %d", tab[l][c]);
        printf("\n");
    }
}

int main()
{
    #define nbrP  4
    #define nbrR  5
    
    int current[nbrP][nbrR] = 
        {
            {2, 0, 1, 3, 0},
            {0, 1, 0, 0, 0},
            {2, 1, 1, 0, 0},
            {0, 0, 0, 0, 1},
        };
    affiche(nbrP, nbrR, current);
    
    return EXIT_SUCCESS;
}
